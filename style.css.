* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "Poppins", Arial, sans-serif;
  background: #fff7fb;
  color: #514354;
}

.hero {
  min-height: 90vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 40px 20px;
  background: linear-gradient(135deg, #ffe5ef, #eee6ff);
}

.hero h1 {
  font-size: clamp(2.2rem, 7vw, 4.5rem);
  margin: 12px 0;
  color: #9b6b91;
}

.hero p {
  max-width: 550px;
  line-height: 1.7;
  font-size: 1.05rem;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 3px;
  font-size: 0.8rem;
  color: #9b6b91;
}

.button {
  display: inline-block;
  margin-top: 20px;
  padding: 13px 25px;
  border-radius: 30px;
  background: #b98bb4;
  color: white;
  text-decoration: none;
  transition: transform 0.2s, background 0.2s;
}

.button:hover {
  background: #9f709a;
  transform: translateY(-3px);
}

section {
  padding: 65px 20px;
  text-align: center;
}

section h2 {
  color: #9b6b91;
  font-size: 2rem;
}

.message-card {
  max-width: 650px;
  margin: 25px auto 0;
  padding: 30px;
  border-radius: 22px;
  background: white;
  box-shadow: 0 8px 30px rgba(130, 90, 130, 0.10);
  line-height: 1.8;
}

footer {
  padding: 25px;
  text-align: center;
  background: #f2e8f5;
  font-size: 0.9rem;
}
.hidden {
  display: none;
}

#surpriseMessage {
  margin-top: 20px;
  color: #9b6b91;
  font-weight: 600;
}
